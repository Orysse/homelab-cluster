// Headscale ACLs (HuJSON). admins: the homelab networks, like wg0. Headscale groups list
// users (their Pocket-ID username + "@"), not OIDC groups: a new admin goes here too.
// Everyone else (Pocket-ID group "visitors"): the internal gateway (*.int, read-only views)
// and the Kubernetes API (RBAC "view", oidc-rbac.yaml); no SSH, no hosts, no LAN.
// 192.168.1.151: the family NAS (Synology, music library), admins only.
// autogroup:internet: admins may use nuc1 as an exit node (all their traffic through home).
// home-nas (100.64.0.10): the video NAS at Lenny's (Synology), NFS (2049) from nuc1 only: kube-0 mounts it
// through nuc1, which masquerades it (homelab-nix tailscale.nix). Neither side has any other rule.
// tag:gamehost: Sunshine game-streaming host (laptop at home), reachable by admins only, on the
// Sunshine ports (no web UI 47990: pair locally) and SSH (22, Windows OpenSSH). It has no rule of its own as a source.
{
  "groups": { "group:admins": ["abelc@", "Kenny@"] },
  "hosts": { "nuc1": "100.64.0.1/32", "home-nas": "100.64.0.10/32" },
  "tagOwners": { "tag:gamehost": ["group:admins"] },
  "acls": [
    { "action": "accept", "src": ["group:admins"], "dst": ["tag:gamehost:22,47984,47989,48010,47998-48000,48002"] },
    { "action": "accept", "src": ["group:admins"], "dst": ["192.168.1.192/26:*"] },
    { "action": "accept", "src": ["group:admins"], "dst": ["192.168.1.151/32:*"] },
    { "action": "accept", "src": ["group:admins"], "dst": ["autogroup:internet:*"] },
    { "action": "accept", "src": ["nuc1"], "dst": ["home-nas:2049"] },
    { "action": "accept", "src": ["*"], "dst": ["192.168.1.241:443", "192.168.1.210:6443"] }
  ]
}
