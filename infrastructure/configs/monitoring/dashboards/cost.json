{
  "uid": "homelab-cost",
  "title": "Coût et conso",
  "tags": [
    "homelab",
    "cost"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prix_kwh",
        "label": "EUR/kWh (EDF Tarif Bleu)",
        "type": "constant",
        "hide": 2,
        "query": "0.2001",
        "current": {
          "text": "0.2001",
          "value": "0.2001"
        }
      },
      {
        "name": "rendement",
        "label": "Rendement de l'alimentation",
        "type": "constant",
        "hide": 2,
        "query": "0.85",
        "current": {
          "text": "0.85",
          "value": "0.85"
        }
      },
      {
        "name": "ovh_an",
        "label": "OVH, EUR/an (domaine + mail)",
        "type": "constant",
        "hide": 2,
        "query": "27.58",
        "current": {
          "text": "27.58",
          "value": "27.58"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "nuc1 à la prise (estimation)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Puissance",
      "description": "RAPL psys / rendement de l'alimentation (~85 %).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#ff7a1a"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(node_rapl_psys_joules_total{host=\"nuc1\"}[5m]) / $rendement",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Moyenne 24 h",
      "description": "Puissance moyenne sur les dernières 24 heures.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#e2135f"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg_over_time((rate(node_rapl_psys_joules_total{host=\"nuc1\"}[5m]))[24h:5m]) / $rendement",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Énergie 30 j",
      "description": "Énergie consommée sur 30 jours (ou depuis le début de la mesure).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#18b39b"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "increase(node_rapl_psys_joules_total{host=\"nuc1\"}[30d]) / $rendement / 3600000",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Électricité / mois",
      "description": "Projection sur un mois à la puissance moyenne des 7 derniers jours.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#7b2ff7"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg_over_time((rate(node_rapl_psys_joules_total{host=\"nuc1\"}[5m]))[7d:5m]) / $rendement / 1000 * 730 * $prix_kwh",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total / an",
      "description": "Électricité projetée sur un an (moyenne 7 j) + OVH (domaine et mail). Sans amortissement du matériel.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#18b3e0"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "avg_over_time((rate(node_rapl_psys_joules_total{host=\"nuc1\"}[5m]))[7d:5m]) / $rendement / 1000 * 8760 * $prix_kwh + $ovh_an",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Cluster / mois (OpenCost)",
      "description": "Coût horaire des trois nœuds selon OpenCost (électricité + OVH répartis sur CPU et RAM), sur un mois.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#ffcf5a"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(max by (exported_node) (node_total_hourly_cost)) * 730",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Puissance",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "à la prise (estimée)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff7a1a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU (package)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7b2ff7"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "à la prise (estimée)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(node_rapl_psys_joules_total{host=\"nuc1\"}[5m]) / $rendement",
          "legendFormat": "à la prise (estimée)",
          "instant": false,
          "range": true
        },
        {
          "refId": "CPU (package)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "rate(node_rapl_package_joules_total{host=\"nuc1\"}[5m])",
          "legendFormat": "CPU (package)",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Répartition par namespace (OpenCost)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "piechart",
      "title": "Coût mensuel par namespace",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 10,
        "h": 10
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ],
          "sortBy": "Value",
          "sortDesc": true
        },
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (exported_namespace) (container_cpu_allocation * on (exported_node) group_left () max by (exported_node) (node_cpu_hourly_cost) + container_memory_allocation_bytes / 1073741824 * on (exported_node) group_left () max by (exported_node) (node_ram_hourly_cost)) * 730",
          "legendFormat": "{{exported_namespace}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Coût horaire par namespace",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 10,
        "y": 15,
        "w": 14,
        "h": 10
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean"
          ],
          "sortBy": "Mean",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 4,
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "{{exported_namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (exported_namespace) (container_cpu_allocation * on (exported_node) group_left () max by (exported_node) (node_cpu_hourly_cost) + container_memory_allocation_bytes / 1073741824 * on (exported_node) group_left () max by (exported_node) (node_ram_hourly_cost))",
          "legendFormat": "{{exported_namespace}}",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
