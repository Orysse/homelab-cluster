          "rawSql": "SELECT v.debut AS \"début\", w.name AS site, CASE WHEN s.country ~ '^[A-Z]{2}$' THEN chr(127397 + ascii(substr(s.country, 1, 1))) || chr(127397 + ascii(substr(s.country, 2, 1))) ELSE '·' END || ' ' || coalesce(s.city, s.country, '?') AS lieu, concat_ws(' · ', s.device, s.os, s.browser) AS appareil, v.pages, extract(epoch FROM v.fin - v.debut) AS \"durée\", left(v.parcours, 400) AS parcours FROM (SELECT visit_id, session_id, website_id, min(created_at) AS debut, max(created_at) AS fin, count(*) FILTER (WHERE event_type = 1) AS pages, string_agg(url_path, ' → ' ORDER BY created_at) FILTER (WHERE event_type = 1) AS parcours FROM website_event WHERE $__timeFilter(created_at) AND website_id::text IN ($website) GROUP BY 1, 2, 3) v JOIN session s USING (session_id) JOIN website w ON w.website_id = v.website_id ORDER BY v.debut DESC LIMIT 100"
        }
      ],
      "id": 17
    },
