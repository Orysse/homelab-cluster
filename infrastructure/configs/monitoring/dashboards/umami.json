          "rawSql": "SELECT avg(extract(epoch FROM fin - debut)) FROM (SELECT visit_id, session_id, website_id, min(created_at) AS debut, max(created_at) AS fin, count(*) FILTER (WHERE event_type = 1) AS pages, string_agg(url_path, ' → ' ORDER BY created_at) FILTER (WHERE event_type = 1) AS parcours FROM website_event WHERE $__timeFilter(created_at) AND website_id::text IN ($website) GROUP BY 1, 2, 3) v"
