          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN country ~ '^[A-Z]{2}$' THEN chr(127397 + ascii(substr(country, 1, 1))) || chr(127397 + ascii(substr(country, 2, 1))) ELSE '·' END || ' ' || coalesce(country, '?') AS pays, count(*) AS visiteurs FROM session WHERE session_id IN (SELECT session_id FROM website_event WHERE $__timeFilter(created_at) AND website_id::text IN ($website)) GROUP BY country ORDER BY 2 DESC LIMIT 15"
