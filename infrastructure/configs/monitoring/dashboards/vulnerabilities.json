{
  "uid": "homelab-vulnerabilities",
  "title": "Vulnérabilités",
  "tags": [
    "homelab",
    "security",
    "trivy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Images en cours d'exécution (scan Trivy quotidien)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Critiques corrigeables",
      "description": "CVE critiques pour lesquelles une version corrigée existe : mettre à jour l'image.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#e2135f"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(max by (image) (trivy_image_vulnerabilities_fixable{severity=\"CRITICAL\"}))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Critiques",
      "description": "Toutes les CVE critiques, corrigées en amont ou non.",
